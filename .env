# Hanya untuk environment lokal/testing. Jangan dipakai di production.
# File ini sengaja di-commit supaya cukup `docker compose up` tanpa setup tambahan.
#
# HOST_*_PORT = port di komputer Anda untuk mengakses service (browser, DBeaver, tool testing).
# Antar container tetap memakai port bawaan di jaringan Docker (misalnya postgres:5432).

# Zona waktu semua container (UTC+7)
TZ=Asia/Jakarta

# PostgreSQL
POSTGRES_DB=waroenkqu
POSTGRES_USER=waroenkqu
POSTGRES_PASSWORD=waroenkqu_local
HOST_POSTGRES_PORT=28432

# Redis
HOST_REDIS_PORT=28379

# RabbitMQ
RABBITMQ_USER=waroenkqu
RABBITMQ_PASSWORD=waroenkqu_local
HOST_RABBITMQ_PORT=28672
HOST_RABBITMQ_MANAGEMENT_PORT=28673

# API Services
HOST_API_PORT=28300
JWT_ACCESS_SECRET=local-dev-access-secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
# Interval outbox worker mengecek pesan PENDING (detik)
OUTBOX_POLL_INTERVAL=1

# Catalog Publisher: interval publish katalog (detik). Mewakili 1 hari.
CATALOG_PUBLISH_INTERVAL=300

# Notification Service (WebSocket)
HOST_NOTIFICATION_PORT=28301

# Webapp
HOST_WEBAPP_PORT=28080
